[0m11:41:39.759942 [debug] [Thread-1 (]: On model.sales_project.city_analysis: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "sales_project", "target_name": "dev", "node_id": "model.sales_project.city_analysis"} */

  
    

  create  table "sales_db"."public"."city_analysis__dbt_tmp"
  
  
    as
  
  (
    WITH city_stats AS (
    SELECT
        city,
        COUNT(DISTINCT customer_id) AS total_customers,
        COUNT(DISTINCT sale_id) AS total_invoices,
        SUM(quantity) AS total_quantity_sold,
        SUM(unit_price * quantity) AS total_revenue,
        ROUND(AVG(unit_price * quantity), 2) AS avg_order_value
    FROM "sales_db"."public"."stg_sales"
    GROUP BY city 
)

SELECT
    COALESCE(city,'Unknown') AS city,
    total_customers,
    total_invoices,
    total_quantity_sold,
    total_revenue,
    avg_order_value,
    ROUND(100.0 * total_revenue / SUM(total_revenue) OVER(), 2) AS revenue_percentage
FROM city_stats
HAVING city != 'Unknown'
ORDER BY total_revenue DESC
  );
  
