  create  table "sales_db"."public"."customer_segments__dbt_tmp"
  
  
    as
  
  (
    WITH customer_spending AS (
    SELECT *
    FROM customers_spending
)
SELECT
    c.customer_id,
    c.first_name,
    c.last_name,
    cs.total_orders,
    cs.total_spent,
    CASE 
        WHEN cs.total_spent > 500 THEN 'High Value'
        WHEN cs.total_spent > 200 THEN 'Medium Value'  
        ELSE 'Low Value' 
    END AS customer_segment
FROM "sales_db"."public"."stg_customers" c 
LEFT JOIN customers_spending cs USING (customer_id)
  );
  
