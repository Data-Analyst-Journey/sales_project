[0m17:14:46.236556 [debug] [Thread-1 (]: On model.sales_project.discount_analysis: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "sales_project", "target_name": "dev", "node_id": "model.sales_project.discount_analysis"} */

  
    

  create  table "sales_db"."public"."discount_analysis__dbt_tmp"
  
  
    as
  
  (
    WITH discount_stats AS (
    SELECT
        product_id,
        AVG(discount_percent) AS avg_discount,
        COUNT(*) AS total_sales,
        SUM(quantity) AS total_quantity_sold,
        SUM(unit_price * quantity) AS total_revenue
    FROM "sales_db"."public"."stg_sales"
    GROUP BY product_id    
)

SELECT
    p.product_name,
    p.category,
    ds.avg_discount,
    ds.total_sales,
    ds.total_quantity_sold,
    ds.total_revenue,
    CASE 
        WHEN ds.avg_discount > 5 THEN 'High Discount'
        WHEN ds.avg_discount > 2 THEN 'Medium Discount'  
        ELSE 'Low Discount' 
    END AS discount_category
FROM discount_stats ds 
LEFT JOIN "sales_db"."public"."stg_products" p USING (product_id)
ORDER BY ds.avg_discount DESC
  );
  
