  create  table "sales_db"."public"."weekday_analysis__dbt_tmp"
  
  
    as
  
  (
    SELECT
    EXTRACT(dow FROM sale_date) AS day_number,
    TO_CHAR(sale_date, 'Day') AS day_name,
    COUNT(DISTINCT sale_id) AS total_invoices,
