[0m16:09:27.611529 [debug] [Thread-1 (]: On model.sales_project.clv_analysis: /* {"app": "dbt", "dbt_version": "1.12.0b3", "profile_name": "sales_project", "target_name": "dev", "node_id": "model.sales_project.clv_analysis"} */

  
    

  create  table "sales_db"."public"."clv_analysis__dbt_tmp"
  
  
    as
  
  (
    WITH customer_clv AS (
    SELECT
        customer_id,
        COUNT(DISTINCT sale_id) AS frequency,
        AVG(unit_price * quantity) AS avg_order_value,
        COUNT(DISTINCT DATE_TRUNC('month', sale_date)) AS active_months,
        (COUNT(DISTINCT DATE_TRUNC('month', sale_date)) * AVG(unit_price * quantity)) AS clv
    FROM "sales_db"."public"."stg_sales"
    GROUP BY customer_id    
)
SELECT
    customer_id,
    frequency,
    avg_order_value,
    active_months,
    clv,
    CASE 
        WHEN clv >= PERCENTILE_CONT(0.80) WITHIN GROUP (ORDER BY clv) OVER () 
        THEN 'High CLV'
        WHEN clv >= PERCENTILE_CONT(0.50) WITHIN GROUP (ORDER BY clv) OVER ()
        THEN 'Medium CLV'  
        ELSE 'Low CLV' 
    END AS clv_segment
FROM customer_clv
  );
  
