    total_customers,
    total_invoices,
    total_quantity_sold,
    total_revenue,
    avg_order_value,
    ROUND(100.0 * total_revenue / SUM(total_revenue) OVER(), 2) AS revenue_percentage
FROM city_stats
HAVING city != 'Unknown'
ORDER BY total_revenue DESC
  );
  
